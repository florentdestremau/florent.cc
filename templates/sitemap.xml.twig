<?xml version="1.0" encoding="UTF-8"?>
{% set last_update = (posts|last).date %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <url>
        <loc>{{ url('home') }}</loc>
        <lastmod>{{ last_update|date('Y-m-d\\TH:i:s.v\\Z', 'UTC') }}</lastmod>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
    </url>
    <url>
        <loc>{{ url('about') }}</loc>
        <lastmod>{{ last_update|date('Y-m-d\\TH:i:s.v\\Z', 'UTC') }}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.9</priority>
    </url>
    {%- for post in posts %}
    <url>
        <loc>{{ url('post', post.routeParameters) }}</loc>
        <lastmod>{{ post.date|date('Y-m-d\\TH:i:s.v\\Z', 'UTC') }}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.7</priority>
    </url>
    {%- endfor %}
</urlset>
